#!/bin/sh
### BEGIN INIT INFO
# Provides:          lxc-net
# Required-Start:    $syslog $remote_fs $network
# Required-Stop:     $syslog $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: LXC network bridge setup
### END INIT INFO

# LSB counterpart of lxc-net.service, only installed by the
# pkg.lxc-pve.lsbservice build (see debian/rules): runs the same helper.

. /lib/lsb/init-functions

HELPER=/usr/libexec/lxc/lxc-net
STAMP=/run/lxc-net.started

test -x $HELPER || exit 0

case "$1" in
    start)
        [ -e $STAMP ] && exit 0 # RemainAfterExit=yes
        log_action_begin_msg "Setting up LXC network bridge"
        $HELPER start && touch $STAMP
        status=$?
        log_action_end_msg $status
        exit $status
        ;;
    stop)
        log_action_begin_msg "Tearing down LXC network bridge"
        $HELPER stop
        status=$?
        rm -f $STAMP
        log_action_end_msg $status
        exit $status
        ;;
    restart|force-reload)
        "$0" stop && "$0" start
        ;;
    status)
        [ -e $STAMP ] && exit 0
        exit 3
        ;;
    *)
        echo "Usage: /etc/init.d/lxc-net {start|stop|restart|force-reload|status}" >&2
        exit 3
        ;;
esac
