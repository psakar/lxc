#!/bin/sh
### BEGIN INIT INFO
# Provides:          lxc-monitord
# Required-Start:    $syslog $remote_fs $network
# Required-Stop:     $syslog $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: LXC Container Monitoring Daemon
### END INIT INFO

# LSB counterpart of lxc-monitord.service, only installed by the
# pkg.lxc-pve.lsbservice build (see debian/rules). With --daemon, lxc-monitord
# keeps running in the foreground, so it's backgrounded with a pid file here.

. /lib/lsb/init-functions

NAME=lxc-monitord
DESC="LXC Container Monitoring Daemon"
DAEMON=/usr/libexec/lxc/lxc-monitord
PIDFILE=/run/lxc-monitord.pid

test -x $DAEMON || exit 0

case "$1" in
    start)
        log_daemon_msg "Starting $DESC" "$NAME"
        start-stop-daemon --start --quiet --oknodo --background --make-pidfile \
            --pidfile $PIDFILE --exec $DAEMON -- --daemon
        log_end_msg $?
        ;;
    stop)
        log_daemon_msg "Stopping $DESC" "$NAME"
        start-stop-daemon --stop --quiet --oknodo --retry TERM/10/KILL/5 \
            --pidfile $PIDFILE --remove-pidfile --exec $DAEMON
        log_end_msg $?
        ;;
    restart|force-reload)
        "$0" stop && "$0" start
        ;;
    status)
        status_of_proc -p $PIDFILE $DAEMON $NAME
        ;;
    *)
        echo "Usage: /etc/init.d/$NAME {start|stop|restart|force-reload|status}" >&2
        exit 3
        ;;
esac
